PORT=5000
DATABASE_URL="postgres_url"
JWT_SECRET="secret-jwt-key"
BACKEND_URL="http://localhost:5000"

# File Storage Configuration (Switchable)
# Options: 's3' or 'cloudinary'
STORAGE_PROVIDER="cloudinary"

# CLOUDINARY (set these when you have a Cloudinary account)
CLOUDINARY_CLOUD_NAME="cloud_name"
CLOUDINARY_API_KEY="api_key"
CLOUDINARY_API_SECRET="api_secret"

# AWS S3 (set these when switching STORAGE_PROVIDER to s3)
AWS_ACCESS_KEY_ID="placeholder"
AWS_SECRET_ACCESS_KEY="placeholder"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="placeholder"